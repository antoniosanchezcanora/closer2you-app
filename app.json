{
  "expo": {
    "name": "Stoop",
    "slug": "stoop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stoopbarrio.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF6EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.stoopbarrio.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Stoop usa tu ubicación solo mientras compartes «Vuelvo a casa» con tu gente y la app está abierta."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Stoop usa tus fotos solo si eliges una para la imagen de tu tienda.",
          "cameraPermission": "Stoop usa la cámara solo si haces una foto de la fachada de tu tienda.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
